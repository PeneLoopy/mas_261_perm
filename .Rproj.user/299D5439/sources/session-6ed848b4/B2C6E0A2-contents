## Types of Variables in a Dataset

```{r, echo=F}

Variable <- names(gt_cars)
Definition <- c("Row ID Number",
                 "Name of Manufacturer",
                 "Car Model",
                 "Style of Body (4 categories)",
                 "Number of Gears",
                 "Average City Miles/Gallon")
`Variable Type` <- c("Categorical Nominal", 
                     "Categorical Nominal", 
                     "Categorical Nominal",
                     "Categorical Nominal", 
                     "Quantitative Discrete OR Categorical Ordinal", 
                     "Quantitative Continuous")

Comment <- c("Numbers are row names",
             "", "", "", "Only a few values", "")

gt_data_dict <- tibble(Variable, Definition, `Variable Type`, Comment)

gt_data_dict |> kable() 

